# HTTP connector settings, read by scripts/install-launchd.sh.
# Copy to .env (git-ignored) and fill in. Never put the password hash here.

# Public origin clients reach, with no path. The MCP endpoint is <this>/mcp.
MACOS_MCP_PUBLIC_URL=https://your-mac.your-tailnet.ts.net:8443

# Your Tailscale login (tailscale status --json shows it under User). Only this
# tailnet user can reach the sign-in page; leave unset only if you do not use Tailscale.
MACOS_MCP_TAILSCALE_LOGIN=you@example.com

# Loopback port the server binds; Funnel forwards to it.
MACOS_MCP_HTTP_PORT=8443

# Start with read-only tools; widen after a trial period.
MACOS_MCP_HTTP_TOOLSETS=mail:read,calendar:read,reminders:read,contacts:read,notes:read,messages:read,briefing

# Destructive tools need confirm: true from the model.
MACOS_MCP_CONFIRM_DESTRUCTIVE=true
